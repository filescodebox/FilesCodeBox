go 1.26.5

// 本地多模块联编:make setup 拉取的模块仓库生效
// 版本化 replace 仅覆盖 require 指向的新版本——品牌迁移窗口期新 tag 未发,
// 列车发版后可移除这三行恢复纯 use 映射
use (
	./contracts
	./core
	./server
	./fnos
	./openwrt
	./p2p
	./kit
)

replace github.com/pigeonbox/contracts v0.7.0 => ./contracts
replace github.com/pigeonbox/core v0.14.3 => ./core
replace github.com/pigeonbox/kit v0.3.1 => ./kit
